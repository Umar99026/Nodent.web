# Copy to `.dev.vars` in this folder (gitignored). Required for local login.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
FRONTEND_URL=http://127.0.0.1:5173
ADMIN_KEY=localdev
# Optional — new signup alerts (defaults to ua99026@gmail.com)
# SIGNUP_NOTIFY_EMAIL=ua99026@gmail.com
# RESEND_API_KEY=re_...
# EMAIL_FROM=Nodent <onboarding@resend.dev>
# Google Gemini — long-answer marking, handwriting, question help (server-side only)
# Get keys at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_API_KEY_2=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# Groq Cloud — additional text marking capacity (round-robin with Gemini keys)
# Get keys at https://console.groq.com/keys
# GROQ_API_KEY_1=...
# GROQ_API_KEY_2=...
# GROQ_MODEL=llama-3.1-8b-instant
# OpenAI — English essay marking only (gpt-4o-mini, low cost per essay)
# OPENAI_API_KEY=sk-...
# OPENAI_ENGLISH_MODEL=gpt-4o-mini
