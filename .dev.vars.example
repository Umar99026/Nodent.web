# Copy to `.dev.vars` in this folder (gitignored). Required for local login.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
FRONTEND_URL=http://127.0.0.1:5173
ADMIN_KEY=localdev
# Optional — new signup alerts (defaults to ua99026@gmail.com)
# SIGNUP_NOTIFY_EMAIL=ua99026@gmail.com
# RESEND_API_KEY=re_...
# EMAIL_FROM=Nodent <onboarding@resend.dev>
# Google Gemini — long-answer marking, English scoring, handwriting (server-side only)
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash
